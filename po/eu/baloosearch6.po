#: main.cpp:127
#, kde-format
msgid "query [(|AND|OR) query ...]"
msgstr "itauna [(|AND|OR) itauna ...]"

#: main.cpp:128
#, kde-format
msgid ""
"List of words to query for.\n"
"Each query may be single value, or a value prefixed with a property name.\n"
"Queries may be nested, and grouped with parentheses.\n"
"\n"
"\n"
"Example:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"
msgstr ""
"Itauntzeko hitzen zerrenda.\n"
"Itaun bakoitza balio bakarra izan daiteke, edo aurretik propietate-izen bat "
"duen balioa.\n"
"Itaunak habiaratu eta parentesien bidez taldekatu daitezke.\n"
"\n"
"\n"
"Adibidea:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"

