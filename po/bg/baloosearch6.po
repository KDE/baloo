#: main.cpp:127
#, kde-format
msgid "query [(|AND|OR) query ...]"
msgstr "завка [(|AND|OR) завка ...]"

#: main.cpp:128
#, kde-format
msgid ""
"List of words to query for.\n"
"Each query may be single value, or a value prefixed with a property name.\n"
"Queries may be nested, and grouped with parentheses.\n"
"\n"
"\n"
"Example:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"
msgstr ""
"Списък с думи за търсене.\n"
"Всяко търсене може да бъде единична стойност или стойност с предфикс на име "
"на свойство.\n"
"Търсенията могат да бъдат вгнездени и групирани с скоби.\n"
"\n"
"\n"
"Пример:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"

