#, kde-format
msgid "query [(|AND|OR) query ...]"
msgstr "query [(|AND|OR) query ...]"

#: main.cpp:128
#, kde-format
msgid ""
"List of words to query for.\n"
"Each query may be single value, or a value prefixed with a property name.\n"
"Queries may be nested, and grouped with parentheses.\n"
"\n"
"\n"
"Example:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"
msgstr ""
"Lista de parolas pro consultation.\n"
"Cata consulta (query) pote esser un valor unic, o un valor prefixate  con un "
"nomine de proprietate.\n"
"Consultas pote esser nidiate, e gruppate con parentheses.\n"
"\n"
"\n"
"Exemplo:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"

