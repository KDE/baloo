#: main.cpp:59
#, kde-format
msgid "Baloo Show"
msgstr "Балуов приказ"

#: main.cpp:61
#, kde-format
msgid "The Baloo data Viewer - A debugging tool"
msgstr "Балуов приказивач података — алатка за исправљање"

#: main.cpp:63
#, kde-format
msgid "(c) 2012, Vishesh Handa"
msgstr "© 2012, Вишеш Ханда"

#: main.cpp:68
#, kde-format
msgid "Urls, document ids or inodes of the files"
msgstr "УРЛ‑ови, ИД‑ови документа или и‑чворови фајлова"

#: main.cpp:70
#, kde-format
msgid "Print internal info"
msgstr "Испиши унутрашње податке"

#: main.cpp:72
#, kde-format
msgid "Arguments are interpreted as inode numbers (requires -d)"
msgstr "Аргументи се тумаче као бројеви и‑чворова (захтијева -d)"

#: main.cpp:74
#, kde-format
msgid "Device id for the files"
msgstr "ИД уређаја за фајлове"

#: main.cpp:97
#, kde-format
msgid "Error: -i requires specifying a device (-d <deviceId>)"
msgstr "Грешка: -i захтијева задавање уређаја (-d <deviceId>)"

#: main.cpp:103
#, kde-format
msgid ""
"The Baloo index could not be opened. Please run \"%1\" to see if Baloo is "
"enabled and working."
msgstr ""
"Индекс Балуа не може да се отвори. Извршите „%1“ да провјерите да ли је Балу "
"активиран и у погону."

#: main.cpp:120
#, kde-format
msgid "The document IDs of the Baloo DB and the filesystem are different:"
msgstr "ИД‑ови документа у бази Балуа и у фајл систему се разликују:"

#: main.cpp:139
#, kde-format
msgid "%1: Not a valid url or document id"
msgstr "%1: није исправан УРЛ нити ИД документа"

#: main.cpp:153
#, kde-format
msgid "%1: Failed to parse inode number"
msgstr "%1: не могу да рашчланим број и‑чвора"

#: main.cpp:177
#, kde-format
msgid "%1: No index information found"
msgstr "%1: подаци индекса нису нађени"

#: main.cpp:230
#, kde-format
msgid "Internal Info"
msgstr "Унутрашњи подаци"

#: main.cpp:231
#, kde-format
