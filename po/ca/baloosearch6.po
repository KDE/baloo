# skip-rule: t-apo_ini, t-apo_fim
#: main.cpp:128
#, kde-format
msgid ""
"List of words to query for.\n"
"Each query may be single value, or a value prefixed with a property name.\n"
"Queries may be nested, and grouped with parentheses.\n"
"\n"
"\n"
"Example:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"
msgstr ""
"Llista de paraules a consultar.\n"
"Cada consulta pot ser un valor individual o un valor prefixat amb un nom de "
"propietat.\n"
"Les consultes es poden imbricar i agrupar amb parèntesis.\n"
"\n"
"\n"
"Exemple:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"

