#: main.cpp:158
#, kde-format
msgid ""
"List of words to query for.\n"
"Each query may be single value, or a value prefixed with a property name.\n"
"Queries may be nested, and grouped with parentheses.\n"
"\n"
"\n"
"Example:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"
msgstr ""
"Zoznam slov na vyhľadanie.\n"
"Každý dopyt môže byť jedna hodnota alebo hodnota s predponou názvu "
"vlastnosti.\n"
"Dopyty možno vnárať a zoskupovať zátvorkami.\n"
"\n"
"\n"
"Príklad:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"

