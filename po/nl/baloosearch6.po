msgid "query [(|AND|OR) query ...]"
msgstr "zoekopdracht [(|AND|OR) zoekopdracht ...]"

#: main.cpp:128
#, kde-format
msgid ""
"List of words to query for.\n"
"Each query may be single value, or a value prefixed with a property name.\n"
"Queries may be nested, and grouped with parentheses.\n"
"\n"
"\n"
"Example:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"
msgstr ""
"Lijst met zoektermen.\n"
"Elke zoekopdracht kan een enkele waarde zijn, of een waarde voorafgegaan "
"door een eigenschapsnaam.\n"
"Zoekopdrachten kunnen worden genest en tussen haakjes worden gegroepeerd.\n"
"\n"
"\n"
"Voorbeeld:baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg "
"OR filename:jpg)'"

