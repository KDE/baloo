#: main.cpp:157
#, kde-format
msgid "query [(|AND|OR) query ...]"
msgstr "søk [(|AND|OR) søk …]"

#: main.cpp:158
#, kde-format
msgid ""
"List of words to query for.\n"
"Each query may be single value, or a value prefixed with a property name.\n"
"Queries may be nested, and grouped with parentheses.\n"
"\n"
"\n"
"Example:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"
msgstr ""
"Liste over ord å søkja etter.\n"
"Kvart søk kan vera ein enkeltverdi eller ein verdi med eit eigenskapsnamn "
"som prefiks.\n"
"Du kan ha søk inni andre søk, og også gruppert med parentesar.\n"
"\n"
"\n"
"Eksempel:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"

