#: main.cpp:33
#, kde-format
msgid ""
"Filter by device id.\n"
"0 (default) does not filter and everything is printed.\n"
"Positive numbers are including filters printing only the mentioned device "
"id.\n"
"Negative numbers are excluding filters printing everything but the mentioned "
"device id.\n"
"May be given multiple times."
msgstr ""
"Filtriraj po ID‑u uređaja.\n"
"0 (podrazumijevano) ne filtrira ništa, sve se ispisuje.\n"
"Pozitivni brojevi znače ispis samo za zadate ID‑ove uređaja.\n"
"Negativni brojevi znače ispis svega osim za zadate ID‑ove uređaja.\n"
"Može se zadati više puta."

#: main.cpp:38
#, kde-format
msgid "integer"
msgstr "cio‑broj"

#: main.cpp:43
#, kde-format
msgid ""
"List only inaccessible entries.\n"
"Only applies to \"%1\""
msgstr ""
"Nabroji samo nedostupne unose.\n"
"Važi samo za „%1“."

#: main.cpp:47
#, kde-format
msgid "Act only on item on mounted devices"
msgstr "Radi samo nad stavkama na montiranim uređajima."

#: main.cpp:51
#, kde-format
msgid ""
"Print results of a cleaning operation, but do not change anything.\n"
"Only applies to \"%1\" command"
msgstr ""
"Ispiši rezultat operacije čišćenja, ali ne mijenjaj ništa.\n"
"Važi samo za naredbu „%1“."

#: main.cpp:59
#, kde-format
msgid ""
"List database contents. Use a regular expression as argument to filter output"
msgstr ""
"Izlistaj sadržaj baze podataka. Zadajte regularni izraz kao argument radi "
"filtriranja ispisa."

#: main.cpp:70
#, kde-format
msgid "List devices"
msgstr "Nabroji uređaje"

#: main.cpp:85
#, kde-format
msgid "Remove stale database entries"
msgstr "Ukloni zastarjele unose iz baze podataka"

