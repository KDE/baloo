msgstr "Prikaži identifikacije dokumenta"

#: main.cpp:123
#, kde-format
msgid "Sorting criteria"
msgstr "Kriterij razvrščanja"

#: main.cpp:127
#, kde-format
msgid "query [(|AND|OR) query ...]"
msgstr "poizvedba [(|AND|OR) poizvedba ...]"

#: main.cpp:128
#, kde-format
msgid ""
"List of words to query for.\n"
"Each query may be single value, or a value prefixed with a property name.\n"
"Queries may be nested, and grouped with parentheses.\n"
"\n"
"\n"
"Example:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"
msgstr ""
"Seznam iskalnih izrazov.\n"
"Vsaka poizvedba je lahko posamezna vrednost ali vrednost s predpono v obliki "
"imena lastnosti.\n"
"Poizvedbe je mogoče gnezditi in družiti z oklepaji.\n"
"\n"
"\n"
"Primer:\n"
"baloosearch6 -t image 'width<=2000 (filename:png OR filename:jpeg OR "
"filename:jpg)'"

#: main.cpp:161
#, kde-format
msgid "ERROR: Invalid \"type\" value, supported values:\n"
msgstr "NAPAKA: Neveljavno \"type\" vrednost, podprte vrednosti:\n"

